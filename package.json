{
  "name": "@algosail/plyfuture",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algosail/plyfuture.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "workerd": "./src/mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint . --fix",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --disable-warning=ExperimentalWarning --experimental-transform-types --test test/*_test.ts"
  },
  "devDependencies": {
    "@algosail/eslint-config": "^0.3.0",
    "@types/node": "^24.7.0",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@algosail/ply": "^0.1.3"
  }
}
